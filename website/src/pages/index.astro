---
// Landing page — overrides Starlight's default index
// Links into Starlight docs at /getting-started/what-is-ramp/
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>RAMP Protocol — Open Transaction Protocol for AI Content Access</title>
  <meta name="description" content="The open protocol that turns blocked bots into paying customers. Discover, price, transact, deliver, verify — one protocol for any content." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --accent: #4f6df5;
      --accent-glow: #4f6df533;
      --accent-dark: #3d58d6;
      --black: #0a0a0f;
      --near-black: #12121a;
      --dark: #1a1a26;
      --mid: #2a2a3a;
      --gray: #8888a0;
      --light-gray: #c0c0d0;
      --off-white: #e8e8f0;
      --white: #f5f5fa;
      --bg-light: #fafafa;
      --mono: 'DM Mono', monospace;
      --sans: 'Instrument Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      font-family: var(--sans);
      color: var(--off-white);
      background: var(--black);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ========= HERO ========= */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, var(--accent-glow) 0%, transparent 70%),
        linear-gradient(180deg, var(--near-black) 0%, var(--black) 100%);
      pointer-events: none;
    }

    .hero-nav {
      position: relative;
      z-index: 10;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 2.5rem;
      max-width: 1280px;
      margin: 0 auto;
      width: 100%;
    }

    .logo {
      font-family: var(--sans);
      font-size: 1.125rem;
      font-weight: 600;
      letter-spacing: -0.03em;
      text-decoration: none;
      color: var(--off-white);
      text-transform: lowercase;
    }

    .nav-links {
      display: flex;
      gap: 2rem;
      list-style: none;
    }
    .nav-links a {
      color: var(--gray);
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 500;
      transition: color 0.2s;
    }
    .nav-links a:hover { color: var(--off-white); }

    .hero-content {
      position: relative;
      z-index: 10;
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem 2rem 4rem;
      max-width: 900px;
      margin: 0 auto;
    }

    .hero-badge {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 1.5rem;
      padding: 0.4rem 1rem;
      border: 1px solid var(--accent);
      border-radius: 2px;
    }

    .hero h1 {
      font-size: clamp(2.25rem, 5vw, 3.5rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--white);
      margin-bottom: 1.25rem;
    }
    .hero h1 em {
      font-style: normal;
      color: var(--accent);
    }

    .hero-sub {
      font-size: 1.125rem;
      color: var(--gray);
      line-height: 1.6;
      max-width: 640px;
      margin-bottom: 2.5rem;
    }

    .hero-buttons {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.75rem;
      font-family: var(--sans);
      font-size: 0.9375rem;
      font-weight: 600;
      text-decoration: none;
      border-radius: 3px;
      transition: all 0.2s;
    }
    .btn-primary {
      background: var(--accent);
      color: #fff;
      border: 1px solid var(--accent);
    }
    .btn-primary:hover {
      background: var(--accent-dark);
      border-color: var(--accent-dark);
    }
    .btn-ghost {
      background: transparent;
      color: var(--off-white);
      border: 1px solid var(--mid);
    }
    .btn-ghost:hover {
      border-color: var(--gray);
      background: var(--dark);
    }

    /* ========= FLOW SECTION ========= */
    .flow-section {
      background: var(--black);
      padding: 5rem 2rem;
      position: relative;
    }

    .flow-section::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--mid), transparent);
    }

    .section-header {
      text-align: center;
      max-width: 640px;
      margin: 0 auto 3rem;
    }

    .section-label {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.15em;
      margin-bottom: 0.75rem;
    }

    .section-header h2 {
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      color: var(--white);
      margin-bottom: 0.75rem;
    }

    .section-header p {
      color: var(--gray);
      font-size: 1rem;
      line-height: 1.6;
    }

    /* Flow Steps */
    .flow-container {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }

    .flow-steps {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .flow-step {
      display: flex;
      gap: 1rem;
      padding: 1rem 0;
      opacity: 0.35;
      transition: opacity 0.5s, transform 0.5s;
      position: relative;
      cursor: pointer;
    }
    .flow-step:hover {
      opacity: 0.7;
    }
    .flow-step.active {
      opacity: 1;
    }
    .flow-step.active:hover {
      opacity: 1;
    }

    .step-indicator {
      display: flex;
      flex-direction: column;
      align-items: center;
      flex-shrink: 0;
      width: 2.5rem;
    }

    .step-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--mid);
      border: 2px solid var(--mid);
      transition: all 0.4s;
      flex-shrink: 0;
    }
    .flow-step.active .step-dot {
      background: var(--accent);
      border-color: var(--accent);
      box-shadow: 0 0 12px var(--accent-glow);
    }

    .step-line {
      width: 2px;
      flex: 1;
      background: var(--mid);
      transition: background 0.4s;
    }
    .flow-step.active .step-line { background: var(--accent); }
    .flow-step:last-child .step-line { display: none; }

    .step-content {
      padding-bottom: 0.5rem;
    }

    .step-num {
      font-family: var(--mono);
      font-size: 0.6875rem;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.25rem;
    }

    .step-title {
      font-size: 1.0625rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 0.25rem;
    }

    .step-desc {
      font-size: 0.9375rem;
      color: var(--gray);
      line-height: 1.5;
    }

    .step-desc code {
      font-family: var(--mono);
      font-size: 0.8125rem;
      color: #7ec8a0;
      background: rgba(126, 200, 160, 0.1);
      padding: 0.125rem 0.375rem;
      border-radius: 2px;
    }

    .step-link {
      display: inline-block;
      margin-top: 0.375rem;
      font-family: var(--mono);
      font-size: 0.6875rem;
      color: var(--accent);
      text-decoration: none;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .step-link:hover { text-decoration: underline; }
    .flow-step.active .step-link { opacity: 1; }

    /* Flow JSON preview */
    .flow-json {
      background: var(--near-black);
      border: 1px solid var(--mid);
      border-radius: 4px;
      padding: 1.5rem;
      font-family: var(--mono);
      font-size: 0.875rem;
      line-height: 1.7;
      color: var(--gray);
      overflow: hidden;
      position: sticky;
      top: 2rem;
      align-self: start;
    }

    .flow-json {
      transition: opacity 0.3s;
    }
    .flow-json.fading { opacity: 0.3; }

    /* JSON syntax colors are applied via inline styles in JS
       because Astro scopes class-based CSS and dynamically
       injected innerHTML won't have the scoping attributes. */

    /* ========= NxM SECTION ========= */
    .nxm-section {
      background: var(--bg-light);
      color: var(--near-black);
      padding: 6rem 2rem;
    }

    .nxm-grid {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .nxm-panel {
      padding: 2rem;
      border-radius: 6px;
      position: relative;
    }
    .nxm-panel.without {
      background: #fff;
      border: 1px solid #e0e0e0;
    }
    .nxm-panel.with {
      background: #fff;
      border: 2px solid var(--accent);
    }

    .nxm-label {
      font-family: var(--mono);
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 1.5rem;
      font-weight: 500;
    }
    .nxm-panel.without .nxm-label { color: #999; }
    .nxm-panel.with .nxm-label { color: var(--accent); }

    .nxm-diagram {
      position: relative;
      margin-bottom: 1.25rem;
    }
    .nxm-diagram canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
    }

    .nxm-nodes {
      position: absolute;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .nxm-nodes.left { left: 0; top: 50%; transform: translateY(-50%); }
    .nxm-nodes.right { right: 0; top: 50%; transform: translateY(-50%); }
    .nxm-nodes.center {
      left: 50%; top: 50%;
      transform: translate(-50%, -50%);
    }

    .nxm-node {
      font-family: var(--mono);
      font-size: 0.6875rem;
      padding: 0.375rem 0.75rem;
      border-radius: 3px;
      white-space: nowrap;
      font-weight: 500;
    }
    .nxm-node.agent {
      background: var(--near-black);
      color: var(--off-white);
    }
    .nxm-node.exchange {
      background: #e8e8e8;
      color: #444;
    }
    .nxm-node.ramp-hub {
      background: var(--accent);
      color: #fff;
      padding: 0.75rem 1.25rem;
      font-size: 0.8125rem;
      font-weight: 600;
      font-family: var(--sans);
    }

    /* SVG lines removed — using canvas for accurate DOM-position lines */

    .nxm-stat {
      font-size: 2.5rem;
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1;
      margin-bottom: 0.375rem;
    }
    .nxm-panel.without .nxm-stat { color: #bbb; }
    .nxm-panel.with .nxm-stat { color: var(--accent); }

    .nxm-caption {
      font-size: 0.875rem;
      color: #777;
      line-height: 1.5;
    }

    /* ========= ARCHITECTURE FLOW ========= */
    .arch-section {
      background: var(--black);
      padding: 5rem 2rem;
      border-top: 1px solid var(--mid);
    }

    .arch-tabs {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-bottom: 2rem;
    }
    .arch-tab {
      font-family: var(--mono);
      font-size: 0.75rem;
      padding: 0.5rem 1.25rem;
      background: var(--dark);
      border: 1px solid var(--mid);
      color: var(--gray);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .arch-tab:hover { border-color: var(--accent); color: var(--off-white); }
    .arch-tab.active { background: var(--accent); border-color: var(--accent); color: #fff; }

    .arch-story {
      max-width: 1000px;
      margin: 0 auto 1.5rem;
      padding: 1.25rem 1.5rem;
      background: var(--dark);
      border-radius: 4px;
      border-left: 3px solid var(--accent);
      font-size: 1rem;
      color: var(--light-gray);
      line-height: 1.7;
    }

    .arch-container {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 2rem;
    }

    .arch-steps-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* Each step row: number | from → to | description */
    .arch-step-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.75rem;
      cursor: pointer;
      border-radius: 4px;
      transition: all 0.2s;
      border: 1px solid transparent;
    }
    .arch-step-row:hover {
      background: var(--dark);
    }
    .arch-step-row.active {
      background: rgba(79, 109, 245, 0.08);
      border-color: rgba(79, 109, 245, 0.3);
    }

    .arch-step-num {
      width: 1.625rem;
      height: 1.625rem;
      border-radius: 50%;
      background: var(--mid);
      color: var(--gray);
      font-family: var(--mono);
      font-size: 0.625rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: all 0.3s;
    }
    .arch-step-row.active .arch-step-num {
      background: var(--accent);
      color: #fff;
      box-shadow: 0 0 10px var(--accent-glow);
    }

    .arch-step-parties {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      flex-shrink: 0;
      min-width: 10rem;
    }

    .arch-party {
      font-family: var(--mono);
      font-size: 0.625rem;
      padding: 0.2rem 0.4rem;
      border-radius: 2px;
      background: var(--dark);
      color: var(--light-gray);
      border: 1px solid var(--mid);
      white-space: nowrap;
    }
    .arch-party.exchange {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
    .arch-step-row.active .arch-party {
      border-color: var(--accent);
    }

    .arch-step-arrow {
      color: var(--gray);
      font-size: 0.75rem;
      flex-shrink: 0;
    }
    .arch-step-row.active .arch-step-arrow { color: var(--accent); }

    .arch-step-desc {
      font-size: 0.75rem;
      color: var(--gray);
      line-height: 1.4;
    }
    .arch-step-row.active .arch-step-desc { color: var(--light-gray); }

    /* Detail panel */
    .arch-detail {
      background: var(--near-black);
      border: 1px solid var(--mid);
      border-radius: 4px;
      padding: 1.5rem;
      font-family: var(--mono);
      font-size: 0.875rem;
      line-height: 1.7;
      color: var(--gray);
      align-self: start;
      position: sticky;
      top: 2rem;
      transition: opacity 0.3s;
      min-height: 200px;
    }

    @media (max-width: 768px) {
      .arch-container { grid-template-columns: 1fr; }
      .arch-detail { position: static; }
      .arch-step { right: -1.5rem !important; }
    }

    /* ========= ROLES SECTION ========= */
    .roles-section {
      background: var(--black);
      padding: 6rem 2rem;
    }

    .roles-grid {
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .role-card {
      background: var(--near-black);
      border: 1px solid var(--mid);
      border-radius: 4px;
      padding: 2rem 1.5rem;
      cursor: pointer;
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }
    .role-card:hover, .role-card.expanded {
      border-color: var(--accent);
      background: var(--dark);
    }

    .role-icon {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }

    .role-title {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--white);
      margin-bottom: 0.5rem;
    }

    .role-teaser {
      font-size: 0.8125rem;
      color: var(--gray);
      line-height: 1.5;
      margin-bottom: 0;
      transition: margin 0.3s;
    }
    .role-card.expanded .role-teaser { margin-bottom: 1.25rem; }

    .role-steps {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.4s ease;
    }
    .role-card.expanded .role-steps {
      max-height: 20rem;
    }

    .role-step {
      display: flex;
      gap: 0.75rem;
      margin-bottom: 0.75rem;
      align-items: flex-start;
    }

    .role-step-num {
      font-family: var(--mono);
      font-size: 0.6875rem;
      color: var(--accent);
      font-weight: 500;
      flex-shrink: 0;
      padding-top: 0.125rem;
    }

    .role-step-text {
      font-size: 0.8125rem;
      color: var(--light-gray);
      line-height: 1.5;
    }
    .role-step-text code {
      font-family: var(--mono);
      font-size: 0.75rem;
      background: var(--mid);
      padding: 0.125rem 0.375rem;
      border-radius: 2px;
      color: var(--off-white);
    }

    .role-footer {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--accent);
      margin-top: 0.5rem;
      opacity: 0;
      transition: opacity 0.3s;
    }
    .role-card.expanded .role-footer { opacity: 1; }

    /* ========= STANDARDS STACK ========= */
    .standards-section {
      background: var(--near-black);
      padding: 5rem 2rem;
    }

    .stack-table {
      max-width: 720px;
      margin: 0 auto 2.5rem;
    }

    .stack-row {
      display: grid;
      grid-template-columns: 4rem 10rem 1fr;
      gap: 0.75rem;
      align-items: center;
      padding: 0.5rem 0.75rem;
      border-bottom: 1px solid var(--mid);
    }
    .stack-row:last-child { border-bottom: none; }

    .stack-row.stack-ramp {
      background: rgba(79, 109, 245, 0.08);
      border: 1px solid rgba(79, 109, 245, 0.25);
      border-radius: 4px;
      margin: 0.25rem -0.25rem;
      padding: 0.625rem 1rem;
    }

    .stack-layer {
      font-family: var(--mono);
      font-size: 0.625rem;
      color: var(--gray);
      text-transform: uppercase;
    }

    .stack-name {
      font-size: 0.8125rem;
      font-weight: 600;
      color: var(--off-white);
    }
    .stack-ramp .stack-name {
      color: var(--accent);
    }

    .stack-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      align-items: center;
    }

    .standard-tag {
      font-family: var(--mono);
      font-size: 0.6875rem;
      color: var(--light-gray);
      padding: 0.2rem 0.5rem;
      background: var(--dark);
      border-radius: 2px;
      white-space: nowrap;
    }

    .standard-tag.ramp-tag {
      background: var(--accent);
      color: #fff;
      font-weight: 500;
    }

    .stack-note {
      font-size: 0.6875rem;
      color: var(--accent);
      font-style: italic;
    }

    .standards-feeds {
      max-width: 720px;
      margin: 0 auto;
      text-align: center;
    }

    .feeds-row {
      display: flex;
      justify-content: center;
      gap: 2rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .feeds-group {
      text-align: center;
    }

    .feeds-label {
      font-family: var(--mono);
      font-size: 0.625rem;
      color: var(--gray);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.5rem;
    }

    .standard-tag.feed-tag {
      background: transparent;
      border: 1px solid var(--mid);
      color: var(--light-gray);
    }

    .feeds-link {
      font-family: var(--mono);
      font-size: 0.75rem;
      color: var(--accent);
      text-decoration: none;
    }
    .feeds-link:hover { text-decoration: underline; }

    @media (max-width: 768px) {
      .stack-row { grid-template-columns: 1fr; gap: 0.25rem; }
      .feeds-row { flex-direction: column; gap: 1.25rem; }
    }

    /* ========= CTA ========= */
    .cta-section {
      background: var(--black);
      padding: 6rem 2rem;
      text-align: center;
    }

    .cta-section h2 {
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 700;
      color: var(--white);
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }

    .cta-section p {
      color: var(--gray);
      font-size: 1rem;
      margin-bottom: 2rem;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
      line-height: 1.6;
    }

    .cta-buttons {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* ========= FOOTER ========= */
    .site-footer {
      background: var(--near-black);
      border-top: 1px solid var(--mid);
      padding: 2.5rem 2rem;
      text-align: center;
    }

    .footer-logo {
      font-family: var(--sans);
      font-size: 1rem;
      font-weight: 600;
