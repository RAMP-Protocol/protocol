    const N = 'color:#d4a56a';       // number
    const B = 'color:#666';          // brace
    const C = 'color:#555;font-style:italic'; // comment
    const SIG = 'color:#4f6df5;opacity:0.8';  // signature (accent)
    const LINK = 'display:block;margin-top:1rem;padding-top:0.75rem;border-top:1px solid #2a2a3a;font-family:Instrument Sans,sans-serif;font-size:0.75rem;color:#4f6df5;text-decoration:none';
