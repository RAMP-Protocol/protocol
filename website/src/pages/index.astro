    const NUM_BASE = 'width:1.75rem;height:1.75rem;border-radius:50%;background:#2a2a3a;color:#8888a0;font-family:DM Mono,monospace;font-size:0.75rem;font-weight:500;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.3s;';
    const NUM_ACTIVE = NUM_BASE.replace('background:#2a2a3a;color:#8888a0','background:#4f6df5;color:#fff') + 'box-shadow:0 0 10px rgba(79,109,245,0.2);';
    const PARTIES = 'display:flex;align-items:center;gap:0.3rem;flex-shrink:0;min-width:11rem;';
    const DESC_BASE = 'font-size:0.875rem;color:#8888a0;line-height:1.5;';
    const DESC_ACTIVE = 'font-size:0.875rem;color:#c0c0d0;line-height:1.5;';

    function renderArchSteps() {
      const scenario = scenarios[currentScenario];
      let html = '';
      scenario.steps.forEach((step, i) => {
        const isActive = i === currentArchStep;
        html += `<div style="${isActive ? ROW_ACTIVE : ROW_BASE}" onclick="setArchStep(${i},true)" onmouseenter="this.style.background='#1a1a26'" onmouseleave="this.style.background='${isActive ? 'rgba(79,109,245,0.08)' : 'transparent'}'">
          <div style="${isActive ? NUM_ACTIVE : NUM_BASE}">${i + 1}</div>
          <div style="${PARTIES}">${party(step.from, step.exFrom)}${arrow}${party(step.to, step.exTo)}</div>
          <div style="${isActive ? DESC_ACTIVE : DESC_BASE}">${step.desc}</div>
        </div>`;
      });
      archStepsList.innerHTML = html;
    }

    function stopArchAuto() {
      clearInterval(archTimer);
      archTimer = null;
    }

    function setArchStep(index, fromUser) {
      if (fromUser) stopArchAuto();
      currentArchStep = index;
      const scenario = scenarios[currentScenario];
      const step = scenario.steps[index];

      // Update active row
      renderArchSteps();

      // Update detail panel
      const stepLabel = `<span style="display:block;margin-bottom:0.75rem;font-family:Instrument Sans,sans-serif;font-size:0.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:#4f6df5;">Step ${index+1} — ${step.from} → ${step.to}</span>`;
      const descLine = `<span style="font-size:0.6875rem;color:#8888a0;display:block;margin-bottom:0.5rem;">${step.desc}</span>`;
      const docLink = `<a style="display:block;margin-top:0.75rem;padding-top:0.5rem;border-top:1px solid #2a2a3a;font-family:Instrument Sans,sans-serif;font-size:0.75rem;color:#4f6df5;text-decoration:none;" href="${step.link}">${step.linkText}</a>`;
      archDetailEl.innerHTML = `${stepLabel}${descLine}\n${step.json}\n${docLink}`;
    }

    function renderStory() {
      const scenario = scenarios[currentScenario];
      document.getElementById('archStory').innerHTML = scenario.story;
    }

    function switchScenario(idx) {
      stopArchAuto();
      currentScenario = idx;
      currentArchStep = 0;
      document.getElementById('archTab0').classList.toggle('active', idx === 0);
      document.getElementById('archTab1').classList.toggle('active', idx === 1);
      renderStory();
      renderArchSteps();
      setArchStep(0);
    }

    let archTimer = null;
    function advanceArchStep() {
      const scenario = scenarios[currentScenario];
      setArchStep((currentArchStep + 1) % scenario.steps.length);
    }

    // Init
    renderStory();
    renderArchSteps();
    setArchStep(0);
    archTimer = setInterval(advanceArchStep, 5000);
  </script>

</body>
</html>
