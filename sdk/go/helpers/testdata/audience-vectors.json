      "claimed": [
        "exchange.example:443"
      ],
      "expected_verdict": "accepted",
      "identity_error": false
    },
    {
      "name": "default_port_on_identity",
      "self": "exchange.example:443",
      "claimed": [
        "exchange.example"
      ],
      "expected_verdict": "accepted",
      "identity_error": false
    },
    {
      "name": "default_port_on_both",
      "self": "exchange.example:443",
